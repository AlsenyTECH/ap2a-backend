# Copier en .env et remplir. Ne jamais commiter le fichier .env réel.

# Clé secrète Django (générer une valeur aléatoire longue en production -
# jamais réutiliser celle de développement).
DJANGO_SECRET_KEY=change-moi

# Clé HMAC de signature des cartes QR/NFC (aléatoire, au moins 32 octets, secrète).
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
HMAC_CLE_V1=change-moi
HMAC_VERSION_ACTIVE=1

# Accepter encore les signatures sans séparation de domaine des cartes NFC
# et badges émis avant la mise à jour de sécurité. Passer à False une fois
# tous les supports physiques réémis.
HMAC_ACCEPTER_SIGNATURES_HERITEES=True

# Développement local : True (le défaut est False, sûr pour la production).
DJANGO_DEBUG=True

# Envoi d'email (identifiants de compte Gmail avec mot de passe
# d'application, ou autre SMTP). Laisser vide en développement pour
# utiliser la sortie console à la place d'un envoi réel.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Production uniquement (laisser vide en développement local) ---

# Domaines autorisés, séparés par des virgules (ex: .onrender.com).
DJANGO_ALLOWED_HOSTS=

# URL de connexion PostgreSQL (ex: fournie par Neon/Render) - si vide,
# retombe automatiquement sur SQLite local.
DATABASE_URL=

# Origines du front autorisées à appeler l'API, séparées par des
# virgules (ex: https://ap2a-portail.vercel.app). Si vide, tout est
# autorisé en développement, RIEN en production.
DJANGO_CORS_ALLOWED_ORIGINS=

# --- Réglages de sécurité optionnels (valeurs par défaut entre parenthèses) ---
# Durée de vie d'une session (168 h = 7 jours).
# JETON_DUREE_VIE_HEURES=168
# Limitation des connexions : échecs max par identifiant (5) et par IP (50)
# sur une fenêtre glissante (15 min).
# CONNEXION_MAX_ECHECS_IDENTIFIANT=5
# CONNEXION_MAX_ECHECS_IP=50
# CONNEXION_FENETRE_MINUTES=15
# Validité d'un ticket de scan (120 s) et d'un lien de téléchargement (60 s).
# TICKET_SCAN_DUREE_SECONDES=120
# LIEN_TELECHARGEMENT_DUREE_SECONDES=60
# Exiger un ticket de scan pour confirmer une présence (True). Ne mettre
# False que temporairement, pour un client mobile pas encore mis à jour.
# TICKET_SCAN_OBLIGATOIRE=True

# --- Récupération d'accès super admin (laisser vide en temps normal) ---
# Lues par `python manage.py amorcer_super_admin` (exécutée à chaque
# déploiement) : crée/répare le compte puis SUPPRIMER ces variables.
AP2A_ADMIN_EMAIL=
AP2A_ADMIN_MOT_DE_PASSE=
